                "summary": "Stripe Checkout Session",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "amount",
                                    "type"
                                ],
                                "properties": {
                                    "amount": {
                                        "type": "number",
                                        "description": "Amount in EUR"
                                    },
                                    "type": {
