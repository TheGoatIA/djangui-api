# Server Configuration (Staging)
PORT=5000
NODE_ENV=staging

# Service Ports (Staging Host bindings)
STAGING_PORT=5001
STAGING_MONGODB_PORT=27018
STAGING_REDIS_PORT=6380

# Database Configuration (Staging Docker Networking)
MONGODB_URI=mongodb://mongodb-staging:27017/kauri_staging?replicaSet=rs0

# JWT Secrets (Staging - Change these!)
JWT_ACCESS_SECRET=your_staging_secret_access_key
JWT_REFRESH_SECRET=your_staging_secret_refresh_key

# External APIs (Staging Keys)
GEMINI_API_KEY=your_gemini_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NOTCHPAY_PUBLIC_KEY=your_notchpay_public_key
NOTCHPAY_PRIVATE_KEY=your_notchpay_private_key
NOTCHPAY_WEBHOOK_SECRET=your_notchpay_webhook_secret

# Redis (Staging Docker Networking)
REDIS_URL=redis://redis-staging:6379

# Firebase (for Notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"

# Frontend URL (for CORS Staging)
FRONTEND_URL=https://staging.kauri-app.com

# Mailgun Configuration
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# Uploads
MAX_FILE_SIZE=10485760

# Slack & Alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url
ADMIN_EMAIL=me@borisgauty.com

# Database Backup
BACKUP_PATH=./backups
