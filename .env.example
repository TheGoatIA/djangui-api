# ============================================================
# Kauri API — Fichier d'exemple des variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne commitez JAMAIS le fichier .env dans Git.
# ============================================================

# --- Serveur ---
PORT=5000
NODE_ENV=development
# URL publique de l'API (callbacks de paiement Stripe/NotchPay). En prod,
# remplacer par le domaine réel : https://api.kauri-app.com
SERVER_URL=http://localhost:5000

# --- Base de données MongoDB ---
MONGODB_URI=mongodb://localhost:27017/kauri

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT Secrets ---
# Générer avec : openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGEME_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGEME_GENERATE_WITH_OPENSSL

# --- URLs (CORS) ---
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# --- Documentation Swagger ---
SWAGGER_USER=admin
SWAGGER_PASSWORD=CHANGEME_AT_LEAST_12_CHARS

# --- Uploads ---
MAX_FILE_SIZE=10485760
BACKUP_PATH=./backups

# --- MinIO / S3 Storage ---
MINIO_ENDPOINT=http://localhost:9000
# URL utilisée dans les liens de fichiers renvoyés au client mobile. "localhost"
# ne résout que vers l'hôte du backend lui-même, jamais vers l'émulateur/device —
# 10.0.2.2 est l'alias spécial de l'émulateur Android vers le localhost de l'hôte.
# Pour tester sur un vrai téléphone, utiliser l'IP LAN de la machine hôte.
MINIO_PUBLIC_URL=http://10.0.2.2:9000
MINIO_ACCESS_KEY=CHANGEME
MINIO_SECRET_KEY=CHANGEME
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Metrics ---
METRICS_PORT=9090
METRICS_TOKEN=CHANGEME_GENERATE_WITH_OPENSSL

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# --- NotchPay ---
NOTCHPAY_PUBLIC_KEY=pub_YOUR_KEY_HERE
NOTCHPAY_PRIVATE_KEY=sk_YOUR_KEY_HERE
NOTCHPAY_WEBHOOK_SECRET=YOUR_NOTCHPAY_WEBHOOK_SECRET_HERE

# --- Reseller Hub (Credentials Vault Encryption) ---
# Clé AES-256-GCM (32 octets hex). Générer avec: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=CHANGEME_GENERATE_WITH_OPENSSL_32_BYTES_HEX

# --- Google Gemini IA ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# --- Slack (Alertes internes) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Mailgun (Emails transactionnels) ---
MAILGUN_API_KEY=YOUR_MAILGUN_API_KEY
MAILGUN_DOMAIN=mg.yourdomain.com
