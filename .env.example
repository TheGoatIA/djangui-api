# Server Configuration
PORT=15000
NODE_ENV=production

# Service Ports (Host bindings)
MONGODB_PORT=15001
REDIS_PORT=15002
GRAYLOG_HTTP_PORT=15003
GRAYLOG_GELF_PORT=15004
PROMETHEUS_PORT=15005
GRAFANA_PORT=15006
JAEGER_PORT=15007
OTEL_PORT_GRPC=15008
OTEL_PORT_HTTP=15009

# Database Configuration
MONGODB_USER=admin
MONGODB_PASSWORD=your_strong_password
MONGODB_URI=mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@mongodb:27017/kauri?authSource=admin&replicaSet=rs0

# JWT Secrets (REQUIRED — min 32 chars, generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_here

# External APIs
GEMINI_API_KEY=your_gemini_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NOTCHPAY_PUBLIC_KEY=your_notchpay_public_key
NOTCHPAY_PRIVATE_KEY=your_notchpay_private_key
NOTCHPAY_WEBHOOK_SECRET=your_notchpay_webhook_secret

# Redis (REQUIRED — set a strong password)
REDIS_PASSWORD=your_strong_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Firebase (for Notifications & Backups)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"
FIREBASE_STORAGE_BUCKET=your_bucket_name.appspot.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Mailgun Configuration
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# Uploads
MAX_FILE_SIZE=10485760

# Slack & Alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_ERROR_WEBHOOK_URL=
ADMIN_EMAIL=me@borisgauty.com

# Database Backup
BACKUP_PATH=./backups

# Centralized Logging (Graylog)
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12201
# Generate GRAYLOG_PASSWORD_SECRET: pwgen -N 1 -s 96
GRAYLOG_PASSWORD_SECRET=generate_with_pwgen_96_chars
# Generate GRAYLOG_ROOT_PASSWORD_SHA2: echo -n "your_password" | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=generate_sha256_of_your_graylog_admin_password

# Monitoring (Prometheus)
METRICS_PORT=9090

SWAGGER_USER=admin
# REQUIRED — must be set to a strong password, min 16 chars (generate: openssl rand -base64 16)
SWAGGER_PASSWORD=change_this_to_a_strong_password

# OpenTelemetry
# Default for Docker: http://otel-collector:4317
# Default for Local: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_COLLECTOR_BASE_URL=http://otel-collector:4318

# MinIO / S3 Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=kauriadmin
MINIO_SECRET_KEY=kaurisecret
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Alertmanager (Prometheus → Email + Slack) ─────────────────────────────────
ALERTMANAGER_PORT=9093
ALERTMANAGER_SMTP_HOST=smtp.gmail.com:587
ALERTMANAGER_SMTP_FROM=alerts@kauri-app.com
ALERTMANAGER_SMTP_USER=alerts@kauri-app.com
ALERTMANAGER_SMTP_PASSWORD=your_smtp_app_password
ALERTMANAGER_EMAIL_TO=ops@kauri-app.com
ALERTMANAGER_FINTECH_EMAIL=fintech@kauri-app.com
ALERTMANAGER_SECURITY_EMAIL=security@kauri-app.com
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ── Grafana Alerting (Unified Alerting → Slack + Email) ───────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_in_prod
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=alerts@kauri-app.com
GRAFANA_SMTP_PASSWORD=your_smtp_app_password
GRAFANA_SMTP_FROM=alerts@kauri-app.com
GRAFANA_ALERT_EMAIL_TO=ops@kauri-app.com
GRAFANA_ROOT_URL=https://grafana.kauri-app.com
GRAFANA_SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/CRITICAL/WEBHOOK
GRAFANA_SLACK_WEBHOOK_WARNINGS=https://hooks.slack.com/services/YOUR/WARNINGS/WEBHOOK
GRAFANA_SLACK_WEBHOOK_FINTECH=https://hooks.slack.com/services/YOUR/FINTECH/WEBHOOK
GRAFANA_SLACK_WEBHOOK_SECURITY=https://hooks.slack.com/services/YOUR/SECURITY/WEBHOOK

# ── Metrics endpoint protection ───────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Also write the same value to /etc/prometheus/metrics_token on the Prometheus container
METRICS_TOKEN=generate_with_openssl_rand_hex_32
METRICS_ALLOWED_IPS=

# ── Compliance ─────────────────────────────────────────────────────────────
# How many days AuditLog entries are kept before automatic deletion (TTL).
# Confirm against the actual recordkeeping requirement for your jurisdiction
# before relying on the default. Default: 1825 (5 years).
AUDIT_LOG_RETENTION_DAYS=1825
