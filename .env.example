# ============================================================
# Kauri API — Variables d'environnement (application)
# ============================================================
# Copiez ce fichier en `.env` et renseignez les valeurs réelles.
# Ne commitez JAMAIS le fichier .env dans Git.
#
# Ce fichier documente les variables lues par le code applicatif
# (src/). Les variables nécessaires uniquement à la stack Docker
# d'infrastructure (Mongo/Redis/Grafana/Graylog/Alertmanager...)
# sont documentées séparément dans DEPLOYMENT.md § Variables
# d'infrastructure — elles ne sont PAS lues par le process Node.
#
# `src/server.ts` (validateEnvironment) refuse de démarrer si les
# variables marquées [REQUIS] sont absentes, trop courtes, ou
# contiennent une valeur par défaut faible connue.
# ============================================================

# --- Serveur ---
PORT=5000
NODE_ENV=development
# URL publique de l'API (callbacks de paiement Stripe/NotchPay, liens email).
# En prod : https://api.kauri-app.com
SERVER_URL=http://localhost:5000
# PM2 cluster mode uniquement : PM2 définit automatiquement cette variable
# (0, 1, 2...) sur chaque worker. Le code s'en sert pour n'initialiser les
# cron jobs que sur l'instance 0 — sans ça, chaque worker du cluster
# planifierait les mêmes jobs (rapports, expiration de défis, sauvegardes),
# les exécutant en double. Ne rien mettre ici hors PM2 cluster mode.
# NODE_APP_INSTANCE=0

# --- Base de données MongoDB [REQUIS] ---
# En production, doit utiliser TLS (tls=true, ssl=true, ou mongodb+srv://)
# — sinon le serveur refuse de démarrer. Voir ALLOW_INSECURE_DB_TLS ci-dessous
# pour un opt-out explicite sur réseau privé de confiance.
MONGODB_URI=mongodb://localhost:27017/kauri
# Chemin vers le dossier contenant les binaires mongodump/mongorestore, si
# non présents dans le PATH (utilisé par DbBackupService).
# MONGODB_TOOLS_PATH=/usr/bin

# --- Redis [REQUIS] ---
# En production, doit utiliser TLS (rediss://) — même garde-fou que MongoDB.
REDIS_URL=redis://localhost:6379
# Mot de passe Redis si le serveur en exige un (obligatoire avec le
# docker-compose fourni — voir DEPLOYMENT.md).
REDIS_PASSWORD=

# --- TLS base de données (production uniquement) ---
# Opt-out explicite et documenté de l'exigence TLS ci-dessus, réservé à un
# déploiement où Mongo/Redis sont sur un réseau privé de confiance (VPN,
# VPC, ou TLS terminé hors bande par un proxy). NE PAS activer si Mongo/Redis
# sont accessibles depuis un réseau non maîtrisé.
ALLOW_INSECURE_DB_TLS=false

# --- JWT [REQUIS] ---
# Générer chaque secret séparément avec : openssl rand -hex 32
# Minimum 32 caractères, refusé au démarrage sinon.
JWT_ACCESS_SECRET=CHANGEME_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGEME_GENERATE_WITH_OPENSSL
# Durées de vie (format `ms` — ex: "15m", "7d"). Valeurs par défaut dans le
# code si absentes : access 15 minutes, refresh 7 jours.
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Chiffrement au repos [REQUIS] ---
# Clé maître AES-256-GCM (32 octets hex) utilisée par VaultCrypto pour
# chiffrer les données sensibles en base (identifiants revendeurs, etc.).
# Générer avec : openssl rand -hex 32 — NE JAMAIS faire tourner sans avoir
# migré les données déjà chiffrées avec l'ancienne clé (elles deviennent
# indéchiffrables).
VAULT_ENCRYPTION_KEY=CHANGEME_GENERATE_WITH_OPENSSL_32_BYTES_HEX

# --- CORS ---
# Origines autorisées pour le dashboard admin React et le futur front web.
# Origines codées en dur dans app.ts (kauri-app.com, api.kauri-app.com,
# admin.kauri-app.com) + ADMIN_URL + CORS_ALLOWED_ORIGINS. Ces origines servent
# aussi de liste blanche anti-CSRF pour les requêtes authentifiées par cookie.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# Origines supplémentaires (staging…), séparées par des virgules :
# CORS_ALLOWED_ORIGINS=https://admin-staging.kauri-app.com

# --- Documentation Swagger [REQUIS en production] ---
# Protège /api-docs par Basic Auth. En production, refusé au démarrage si
# absent, égal à "kauri2026", ou < 12 caractères.
SWAGGER_USER=admin
SWAGGER_PASSWORD=CHANGEME_AT_LEAST_12_CHARS

# --- Uploads & sauvegardes locales ---
MAX_FILE_SIZE=10485760
BACKUP_PATH=./backups
UPLOADS_PATH=./uploads

# --- MinIO / Stockage S3-compatible [REQUIS en production] ---
MINIO_ENDPOINT=http://localhost:9000
# URL utilisée dans les liens de fichiers renvoyés au client mobile.
# "localhost" ne résout que vers l'hôte du backend lui-même, jamais vers
# l'émulateur/device — 10.0.2.2 est l'alias spécial de l'émulateur Android
# vers le localhost de l'hôte. Pour tester sur un vrai téléphone, utiliser
# l'IP LAN de la machine hôte.
MINIO_PUBLIC_URL=http://10.0.2.2:9000
# En production, refusé au démarrage si absent, < 12 caractères, ou égal à
# "kaurisecret"/"kauriadmin" (valeurs par défaut faibles connues).
MINIO_ACCESS_KEY=CHANGEME
MINIO_SECRET_KEY=CHANGEME
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Métriques Prometheus ---
# Protège /metrics : IP whitelist (METRICS_ALLOWED_IPS, défaut localhost
# uniquement) OU jeton bearer (METRICS_TOKEN). En production sans aucun des
# deux configurés, l'endpoint est bloqué pour toute IP non whitelistée.
METRICS_TOKEN=CHANGEME_GENERATE_WITH_OPENSSL
# METRICS_ALLOWED_IPS=127.0.0.1,::1,10.0.0.5

# --- Client mobile (télémétrie publique) ---
# Identifie un client mobile officiel sur l'endpoint de télémétrie public
# (/system/telemetry/:type) — pas un vrai secret (embarqué dans l'app), sert
# juste à écarter le spam anonyme. Doit être la même valeur que le
# dart-define LOGS_CLIENT_KEY côté Flutter. REQUIS en production : le serveur
# refuse de démarrer sans cette valeur (hors production, vide = contrôle désactivé).
MOBILE_CLIENT_API_KEY=CHANGEME_GENERATE_WITH_OPENSSL

# --- Liens vérifiés (App Links Android / Universal Links iOS) ---
# Permettent à l'app d'ouvrir directement https://<api>/reset-password/<jeton>
# sans passer par le schéma personnalisé kauri:// (interceptable).
# Empreintes SHA-256 du certificat de signature de l'app (Play Console →
# Intégrité de l'app → Certificat de signature), séparées par des virgules :
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...
# ANDROID_PACKAGE_NAME=cm.tbg.kauri
# Identifiant d'app iOS : <TEAM_ID>.<bundle id>
# IOS_APP_ID=ABCDE12345.cm.tbg.kauri

# --- Stripe [au moins un moyen de paiement requis en production] ---
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
# Optionnel : sans secret de webhook, les paiements sont confirmés par sondage actif (PaymentPollingService, ~1 min).
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# --- NotchPay (Mobile Money) ---
NOTCHPAY_PUBLIC_KEY=pub_YOUR_KEY_HERE
NOTCHPAY_PRIVATE_KEY=sk_YOUR_KEY_HERE
NOTCHPAY_WEBHOOK_SECRET=YOUR_NOTCHPAY_WEBHOOK_SECRET_HERE

# --- Google Gemini IA [REQUIS en production] ---
# Alimente le Coach IA, l'OCR de reçus, l'analyse KYC et la génération
# d'avatar. Refusé au démarrage en production si absent.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Firebase Admin SDK (notifications push) ---
# Fournir SOIT les 3 variables FIREBASE_* individuelles, SOIT
# FIREBASE_SERVICE_ACCOUNT (JSON complet en une ligne), SOIT
# GOOGLE_APPLICATION_CREDENTIALS (chemin vers un fichier JSON). Si aucun
# n'est fourni en production, avertissement au démarrage (non bloquant) —
# les notifications push sont simplement désactivées.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
# Bucket Firebase Storage utilisé comme destination secondaire (disaster
# recovery) des sauvegardes DB, en plus de MinIO.
# FIREBASE_STORAGE_BUCKET=

# --- Slack (alertes internes, multi-canal) ---
# Chaque catégorie a son propre webhook (donc son propre canal Slack). Une
# variable non définie retombe automatiquement sur SLACK_WEBHOOK_URL (ou sur
# la catégorie parente pour "security" → "alert") — rien ne cesse d'alerter
# juste parce qu'un canal dédié n'a pas encore été créé. Voir DEPLOYMENT.md
# § Canaux Slack pour la procédure de création de chaque canal/webhook.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# #kauri-audit — actions admin à fort impact (crédit wallet, changement de
# rôle, export DB, approbation de relance de paiement...).
SLACK_WEBHOOK_AUDIT=
# #kauri-alerts — erreurs système critiques (sauvegarde/restauration
# échouée, remboursement automatique échoué, exception non gérée).
SLACK_WEBHOOK_ALERT=
# #kauri-security — fraude détectée, activité suspecte, signature de
# webhook invalide.
SLACK_WEBHOOK_SECURITY=
# #kauri-finance — réconciliation, écarts financiers, abonnements/churn.
SLACK_WEBHOOK_FINANCE=
# #kauri-transactions — paiements individuels, transactions de montant
# élevé (>500 000 XAF).
SLACK_WEBHOOK_TRANSACTIONS=
# Ancien nom, conservé pour compatibilité — équivalent à SLACK_WEBHOOK_ALERT.
# SLACK_ERROR_WEBHOOK_URL=

# --- Mailgun (emails transactionnels — provider actif) ---
# C'est le SEUL provider email réellement intégré (emailService.ts).
# D'autres noms de variables (SMTP_HOST, BREVO_API_KEY, RESEND_API_KEY,
# SENDGRID_API_KEY) apparaissent dans un panneau de diagnostic admin en
# lecture seule mais ne pilotent aucun envoi réel — ne pas les configurer
# en pensant activer un provider alternatif.
MAILGUN_API_KEY=YOUR_MAILGUN_API_KEY
MAILGUN_DOMAIN=mg.yourdomain.com

# --- Compte admin de démorrage (npm run seed:admin) ---
# Utilisées uniquement par scripts/createAdmin.ts, jamais lues par le
# serveur lui-même. Voir DEPLOYMENT.md § Bootstrap du premier compte admin.
# ADMIN_EMAIL=admin@kauri.app
# ADMIN_PASSWORD=

# --- Rétention légale (audit trail) ---
# Durée de conservation des logs d'audit immuables (AuditLog), en jours.
# Défaut 1825 jours (5 ans) — aligné sur les obligations de rétention
# AML/KYC typiques. Ne réduire qu'après validation juridique.
# AUDIT_LOG_RETENTION_DAYS=1825

# --- SMS local (notifications revendeurs) ---
# Optionnel — si absent, resellerNotificationService désactive l'envoi SMS
# sans bloquer le reste du flux.
# LOCAL_SMS_API_KEY=

# --- Traçage distribué (OpenTelemetry) ---
# ENABLE_TRACING=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_COLLECTOR_BASE_URL=http://localhost:4318
